# Copy to .env.local and fill in.

# MapTiler API key for map tiles: https://cloud.maptiler.com/account/keys/
# Restrict it to your domains in the MapTiler dashboard, since it is sent to browsers.
NEXT_PUBLIC_MAPTILER_KEY=

# Azure Blob Storage for flood report photos (server-only; auth is Entra ID, no keys).
# Locally this uses your `az login`; your account needs "Storage Blob Data Contributor".
AZURE_STORAGE_ACCOUNT_URL=https://floodguardphotos.blob.core.windows.net
AZURE_STORAGE_CONTAINER=flood-reports

# Google AI Studio key (server-only): https://aistudio.google.com/apikey
# Gemini checks each report photo for flooding (depth, extent, hazards); Gemma 4 decides the
# alert level from those findings and forecast data. Without a key, reports stay pending and
# /api/threat falls back to a simple rule-based estimate.
GEMINI_API_KEY=
# Optional photo models (defaults: gemini-3.5-flash, falling back to gemini-3.1-flash-lite).
GEMINI_VISION_MODEL=
GEMINI_VISION_FALLBACK_MODEL=
# Optional: gemma-4-26b-a4b-it (default, fast) or gemma-4-31b-it (slower, stronger).
GEMMA_MODEL=

# Photos-only (demo) mode: estimate the flood threat purely from approved report photos.
# Skips Open-Meteo river/rain/sea-level data and the 48 h report window. Unset or 0 for the full version.
FLOODGUARD_PHOTOS_ONLY=
# Optional: model tried when the main one is overloaded (default gemma-4-31b-it).
GEMMA_FALLBACK_MODEL=

# Azure Database for PostgreSQL Flexible Server: reports and flood-alert data (server-only).
# Auth is Entra ID only, like Blob Storage: locally your `az login` (your account must be an
# Entra admin or role on the server); in Azure, the app's managed identity added as a role.
# Leave PGHOST unset to run without a database (reports stay in blob metadata, alerts off).
PGHOST=psql-floodguard-cus.postgres.database.azure.com
PGDATABASE=floodguard
# The Entra user, group or managed-identity name the token belongs to.
PGUSER=

# Web Push keys for flood alerts. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# Alert checks run in the server every N minutes (default 10; 0 turns the timer off).
# With several instances, set 0 and call POST /api/alerts/run with
# "Authorization: Bearer <ALERT_CRON_SECRET>" from one scheduler instead.
ALERT_CHECK_INTERVAL_MINUTES=
ALERT_CRON_SECRET=

# Azure Container Apps: the app's user-assigned managed identity (client ID). DefaultAzureCredential
# uses it for Blob Storage and Postgres; set PGUSER to the identity's name.
AZURE_CLIENT_ID=
