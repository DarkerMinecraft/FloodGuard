{
  "name": "floodguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "icons": "node scripts/generate-icons.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-azure.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-azure.mjs migrate dev",
    "db:studio": "node scripts/prisma-azure.mjs studio"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "piexifjs": "^1.0.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
